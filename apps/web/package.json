{
  "name": "@readback/web",
  "version": "0.1.0",
  "private": true,
  "description": "Readback's merchant deployment: shopper pages, judge mode, investigator queue and case view, stateless API routes.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec next dev'",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@readback/core": "workspace:*",
    "@readback/evals": "workspace:*",
    "@readback/verify": "workspace:*",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.64.0",
    "vitest": "^5.0.4"
  }
}
