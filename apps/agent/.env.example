# Copy to apps/agent/.env. Never commit it. This is the AGENT side: no PayPal credentials here.

# Generate once with `pnpm --filter @readback/agent keygen` and paste the line it prints.
# This key is permanent: the hero agreement's fingerprint is derived from it.
AGENT_PRIVATE_KEY=

# The merchant's Readback deployment (agreement lookup, checkout, revoke).
MERCHANT_URL=http://localhost:3000

# Secret MCP paths (demo-grade access, THREAT-MODEL T20/T33): /mcp/<secret>. At least 16 random
# characters each, e.g. `node -e "console.log(crypto.randomUUID())"`. The judge one goes in the
# Devpost testing instructions; the hero one is only Dante's connector URL.
HERO_MCP_SECRET=
JUDGE_MCP_SECRET=

# The one agreement each path may act on (payment token IDs). Leave empty until they exist:
# the runtime starts, and every tool refuses.
HERO_AGREEMENT_ID=
JUDGE_AGREEMENT_ID=

PORT=3001
