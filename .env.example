# Copy to .env and fill in. Never commit .env. This file is the MERCHANT side (apps/web, scripts).
# The agent's private key does NOT go here: it lives in apps/agent/.env (see apps/agent/.env.example).

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox.
# Must be a standard merchant REST app (not a platform app) with Vault, Disputes and Transaction Search enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Webhook ID from the app's Webhooks section (needed to verify webhook signatures with PayPal).
PAYPAL_WEBHOOK_ID=

# Claude (terms compiler, briefs, drafts). Server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Circuit breaker for public Claude-backed routes: max Claude calls per day per instance (~1 cent each) (THREAT-MODEL T34).
ANTHROPIC_DAILY_CALLS=500

# Merchant write actions (send, accept and refund, evidence, track) require this; compared server-side.
MERCHANT_ADMIN_TOKEN=

# Where the agent runtime is reachable (its public key is at /.well-known/agent-key).
AGENT_RUNTIME_URL=http://localhost:3001

# Seeded demo agreements (payment token IDs). Set after approving them on PayPal.
HERO_AGREEMENT_ID=
JUDGE_AGREEMENT_ID=
# The hand-opened hero and twist disputes. When both are set, the home page shows them instead of
# the labeled fixtures (falling back to the fixtures if PayPal can't be read).
HERO_DISPUTE_ID=
TWIST_DISPUTE_ID=

# Enables the fenced demo-only routes (POST /api/demo/direct-charge). Sandbox only.
DEMO_MODE=false
