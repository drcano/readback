{
  "name": "@readbackhq/verify",
  "version": "0.1.0",
  "description": "Rebuild an agent-purchase case from PayPal and run Readback's eleven checks: npx @readbackhq/verify <disputeId|captureId>",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "readback-verify": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@readbackhq/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.0.4"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drcano/readback.git",
    "directory": "packages/verify-cli"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "readback-verify": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./fake": {
        "types": "./dist/fake.d.ts",
        "import": "./dist/fake.js"
      }
    }
  }
}
