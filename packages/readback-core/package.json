{
  "name": "@readback/core",
  "version": "0.1.0",
  "description": "Pure, browser-safe verification for AI agent purchases on PayPal: terms, signed mandates, IDs, the eleven checks.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts",
    "./catalog": "./src/catalog.ts"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.0",
    "vitest": "^5.0.4"
  },
  "files": [
    "dist",
    "third_party",
    "CHANGELOG.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drcano/readback.git",
    "directory": "packages/readback-core"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./fixtures": {
        "types": "./dist/fixtures.d.ts",
        "import": "./dist/fixtures.js"
      },
      "./catalog": {
        "types": "./dist/catalog.d.ts",
        "import": "./dist/catalog.js"
      }
    }
  }
}
